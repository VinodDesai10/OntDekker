# Global environment variables
ENVIRONMENT=development

# SMTP configuration (use a newly created app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=replace-with-a-new-app-password
SMTP_FROM_EMAIL=your-email@example.com
SMTP_FROM_NAME=OntDekker
SMTP_USE_TLS=true

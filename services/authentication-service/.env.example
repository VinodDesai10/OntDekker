DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/auth_db
ENVIRONMENT=development
JWT_SECRET=dev_secret_key_replace_this_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REDIS_URL=redis://redis:6379/0
KAFKA_URL=kafka:29092
ALLOWED_ORIGINS=["http://localhost:3000"]

# SMTP — transactional email delivery (OTP verification, password reset, etc.)
# Replace all placeholders with real values before deploying.
# NEVER commit real credentials to version control.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=noreply@ontdekker.com
SMTP_FROM_NAME=OntDekker
SMTP_USE_TLS=true

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/user_db
ENVIRONMENT=development
JWT_SECRET=dev_secret_key_replace_this_in_production
JWT_ALGORITHM=HS256
REDIS_URL=redis://redis:6379/0
KAFKA_URL=kafka:29092
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change_me_in_production
MINIO_SECRET_KEY=change_me_in_production
MINIO_USE_SSL=false
MINIO_BUCKET_PROFILES=profiles
MINIO_MAX_FILE_SIZE=5242880
# MINIO_PUBLIC_URL is the browser-accessible hostname for presigned URLs.
# Inside Docker, MINIO_ENDPOINT is "minio:9000" (Docker internal DNS).
# Presigned URLs generated with that host are unreachable from the user's browser.
# Set MINIO_PUBLIC_URL to the host:port that the browser can reach.
# Local development (host machine): localhost:9000
# Production: your CDN or public S3-compatible hostname.
MINIO_PUBLIC_URL=localhost:9000
ALLOWED_ORIGINS=["http://localhost:3000"]
